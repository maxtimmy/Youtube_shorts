FROM n8nio/n8n:2.8.4 AS n8n_dist

FROM node:22-bookworm AS n8n_builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    python3 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=n8n_dist /usr/local/lib/node_modules/n8n /usr/local/lib/node_modules/n8n
RUN cd /usr/local/lib/node_modules/n8n/node_modules/.pnpm/sqlite3@5.1.7/node_modules/sqlite3 && \
    npm rebuild sqlite3 --build-from-source

FROM node:22-bookworm

USER root

RUN apt-get update && apt-get install -y \
    ffmpeg \
    python3 \
    python3-pip \
    bash \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=n8n_builder /usr/local/lib/node_modules/n8n /usr/local/lib/node_modules/n8n
RUN ln -s /usr/local/lib/node_modules/n8n/bin/n8n /usr/local/bin/n8n

RUN pip3 install --break-system-packages --no-cache-dir \
    faster-whisper

RUN mkdir -p /home/node/.n8n /work/input /work/output /work/temp && \
    chown -R node:node /home/node /work

ENV LD_LIBRARY_PATH="/usr/local/lib:${LD_LIBRARY_PATH}"
ENV N8N_PORT=5678
EXPOSE 5678

USER node
WORKDIR /home/node

CMD ["n8n", "start"]
