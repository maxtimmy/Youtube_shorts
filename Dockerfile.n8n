FROM node:20-bookworm

USER root

RUN apt-get update && apt-get install -y \
    ffmpeg \
    python3 \
    python3-pip \
    bash \
    curl \
    tini \
    && rm -rf /var/lib/apt/lists/*

RUN npm config set fund false && \
    npm config set audit false && \
    npm install -g n8n@2.8.4 --legacy-peer-deps

RUN pip3 install --break-system-packages --no-cache-dir \
    faster-whisper \
    nvidia-cublas-cu12 \
    "nvidia-cudnn-cu12==9.*"

RUN python3 - <<'PY'
import importlib.util
import pathlib

paths = []

for mod in ("nvidia.cublas.lib", "nvidia.cudnn.lib"):
    spec = importlib.util.find_spec(mod)
    if not spec or not spec.submodule_search_locations:
        raise RuntimeError(f"module not found: {mod}")
    paths.extend(str(pathlib.Path(p)) for p in spec.submodule_search_locations)

pathlib.Path("/etc/ld.so.conf.d/nvidia-python.conf").write_text(
    "\n".join(paths) + "\n",
    encoding="utf-8",
)
PY

RUN ldconfig

ENV LD_LIBRARY_PATH="/usr/local/lib:${LD_LIBRARY_PATH}"

RUN mkdir -p /home/node/.n8n /work/input /work/output /work/temp && \
    chown -R node:node /home/node /work

ENV N8N_PORT=5678
EXPOSE 5678

USER node
WORKDIR /home/node

ENTRYPOINT ["tini", "--"]
CMD ["n8n", "start"]
