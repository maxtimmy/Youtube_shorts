# Copy to .env. Never commit real values.
OPENAI_API_KEY=

# Set once before the first n8n start. Use a long random value (32+ characters).
N8N_ENCRYPTION_KEY=replace_with_a_long_random_value
N8N_TIMEZONE=Europe/Moscow

# Local HTTP defaults. Use secure cookies when serving n8n behind HTTPS.
N8N_SECURE_COOKIE=false
N8N_BASE_URL=http://n8n:5678

# Optional: override these after importing/renaming the n8n workflows.
N8N_RENDER_WORKFLOW_ID=168805f3-70c2-48ac-a320-fa599235e0c0
N8N_UPLOAD_WORKFLOW_ID=gsNR0rmVmiG7N2SS

# Optional helper used by the current dashboard implementation.
HOST_DB_HELPER_URL=http://host.docker.internal:8790
