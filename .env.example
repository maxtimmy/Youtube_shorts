# Copy to .env. Never commit real values.
OPENAI_API_KEY=

# Set once before the first n8n start. Use a long random value (32+ characters).
N8N_ENCRYPTION_KEY=replace_with_a_long_random_value
N8N_TIMEZONE=Europe/Moscow

# Local HTTP defaults. Use secure cookies when serving n8n behind HTTPS.
N8N_SECURE_COOKIE=false
N8N_API_URL=http://n8n:5678/api/v1
N8N_API_KEY=
N8N_RENDER_WEBHOOK_URL=http://n8n:5678/webhook/manual-render-queue
N8N_UPLOAD_WEBHOOK_URL=http://n8n:5678/webhook/manual-youtube-upload

# Optional: override these after importing/renaming the n8n workflows.
N8N_RENDER_WORKFLOW_ID=
N8N_UPLOAD_WORKFLOW_ID=

# Credential references are metadata only; never put OAuth secrets here.
# JSON example: [{"id":"n8n-credential-id","name":"YouTube channel name"}]
YOUTUBE_CREDENTIALS_JSON=[]
